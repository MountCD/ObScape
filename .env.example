# Скопируйте в .env и заполните. .env не попадает ни в git, ни в docker-образ.
# Читается docker compose (подстановка ${...}) и самим ob_core при старте.

# --- Postgres (docker compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=obscape

# --- ob_core ---
# Порт на хосте, на который пробрасывается 11080 контейнера.
OB_PORT=11080
# Для локального запуска без compose (в compose собирается из POSTGRES_* выше).
# OBSISTENT_DATABASE=postgres://postgres:change-me@localhost:5432/obscape

# Ключи апстрима по агентам: OBSISTENT_AGENT_<ИМЯ_АГЕНТА_В_ВЕРХНЕМ_РЕГИСТРЕ>_API_KEY.
# Имеют приоритет над api_key в config.toml.
OBSISTENT_AGENT_PRIMARY_API_KEY=sk-...
